// ===================== IProduct.java =====================
public interface IProduct {
    int GetTotalProductsSold();
    double GetAverageProductSold();
    String GetMostPopularProduct();
}

// ===================== Product.java =====================
/** Holds sales data and implements the report calculations. */
public class Product implements IProduct {
    private final String[] names;   // single-dimensional array: product names
    private final int[][] sales;    // two-dimensional array: [product][month]

    public Product(String[] names, int[][] sales) {
        this.names = names;
        this.sales = sales;
    }

    // Total units sold across all products and months
    @Override
    public int GetTotalProductsSold() {
        int total = 0;
        for (int[] productSales : sales) {
            for (int units : productSales) {
                total += units;
            }
        }
        return total;
    }

    // Average units sold per product-month entry (total / number of entries)
    @Override
    public double GetAverageProductSold() {
        int count = 0;
        for (int[] productSales : sales) {
            count += productSales.length;
        }
        return count == 0 ? 0 : (double) GetTotalProductsSold() / count;
    }

    // Product with the highest total sales over all months
    @Override
    public String GetMostPopularProduct() {
        int bestIndex = 0;
        int bestTotal = -1;
        for (int i = 0; i < sales.length; i++) {
            int productTotal = 0;
            for (int units : sales[i]) {
                productTotal += units;
            }
            if (productTotal > bestTotal) {
                bestTotal = productTotal;
                bestIndex = i;
            }
        }
        return names[bestIndex] + " (" + bestTotal + ")";
    }
}

// ===================== PrintProduct.java =====================
/** Responsible only for printing the report data. */
public class PrintProduct {
    private final IProduct product;

    public PrintProduct(IProduct product) {
        this.product = product;
    }

    public void PrintTotalSales() {
        System.out.println("TOTAL PRODUCT SALES: " + product.GetTotalProductsSold());
    }

    public void PrintAverageSales() {
        System.out.println("AVERAGE PRODUCT SALES: " + Math.round(product.GetAverageProductSold()));
    }

    public void PrintMostPopularProduct() {
        System.out.println("MOST POPULAR PRODUCT: " + product.GetMostPopularProduct());
    }
}

// ===================== Main.java =====================
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        String[] names = {"Cozy Nights Monarch", "Restonic Barbados", "Sealy Phuket"};
        int months = 3;
        int[][] sales = new int[names.length][months];

        Scanner input = new Scanner(System.in);
        for (int p = 0; p < names.length; p++) {
            for (int m = 0; m < months; m++) {
                System.out.print("Enter number of sales for month " + (m + 1)
                        + " for " + names[p] + " mattress: ");
                sales[p][m] = input.nextInt();
            }
            System.out.println();
        }

        IProduct product = new Product(names, sales);
        PrintProduct printer = new PrintProduct(product);

        System.out.println("PRODUCT SALES REPORT - 2026");
        System.out.println("*".repeat(45));
        printer.PrintTotalSales();
        printer.PrintAverageSales();
        printer.PrintMostPopularProduct();
    }
}

